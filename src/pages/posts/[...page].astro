---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import List from "@components/blog/list.astro";
import Pagination from "@components/blog/pagination.astro";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';
import { sortArticleList } from "@utils/blog";
import { getCollection } from 'astro:content';
import type { CollectionEntry } from "astro:content";
import type { PaginateFunction } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allArticles = sortArticleList(await getCollection('articles', ({ id, data }) => {
    // only show articles that are not drafts and mind locale
    return !data.draft && id.startsWith(themeConfig.i18n.defaultLocale + '/');
  }) as CollectionEntry<'articles'>[]);
  return paginate(allArticles, { pageSize: themeConfig.articles?.entriesPerPage || 10 });
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const { page } = Astro.props;

const allArticles = page.data as CollectionEntry<'articles'>[];
const numberofPages = Math.ceil(page.total / page.size);
---

<Layout title={t('pages.blog.title') + (page.currentPage > 1 ? ' | ' + t('labels.page') + ' ' + page.currentPage : '')} description={t('pages.blog.description')} noi18n={page.currentPage > 1} {locale}>
  <Headline text={t('pages.blog.title') + (page.currentPage > 1 ? ': ' + t('labels.page') + ' ' + page.currentPage : '')} class="pb-8" />
  {numberofPages > 1 && page.currentPage > 1 && <Pagination {page} {locale} baseUrl="posts" class="mt-0 mb-10" />}
  {allArticles.length > 0 ? <List entries={allArticles} {locale} /> : <p class="text-stone-600 dark:text-stone-300">{t('labels.no-entries')}</p>}
  {numberofPages > 1 && <Pagination {page} {locale} baseUrl="posts" />}
</Layout>
