---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { themeConfig } from '~/theme.config';
import type { PaginateFunction } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allArticles = (await getCollection('articles', ({ id, data }) => {
    return !data.draft && id.startsWith(themeConfig.i18n.defaultLocale + '/');
  })) as CollectionEntry<'articles'>[];
  const uniqueCats = [...new Set(allArticles.flatMap(({ data }) => data.categories ?? []))];
  if (!uniqueCats.length) return [];
  return uniqueCats.flatMap((category) => {
    const filtered = allArticles.filter((article) => article.data.categories?.includes(category));
    return paginate(filtered, {
      params: { category: category.toLowerCase().replace(/\s/g, '-') },
      pageSize: themeConfig.articles?.entriesPerPage || 10,
    });
  });
}

const category = Astro.params.category;
const page = Astro.props.page?.currentPage;
const suffix = page && page > 1 ? `/${page}` : '';
return Astro.redirect(`/posts/categories/${category}${suffix}`, 301);
---
