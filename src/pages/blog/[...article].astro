---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { themeConfig } from '~/theme.config';

export async function getStaticPaths() {
  const entries = (await getCollection('articles', ({ id, data }) => {
    return !data.draft && id.startsWith(themeConfig.i18n.defaultLocale + '/');
  })) as CollectionEntry<'articles'>[];
  return entries.map((entry) => ({
    params: { article: entry.id.split('/')[1] || undefined },
  }));
}

return Astro.redirect(`/posts/${Astro.params.article}`, 301);
---
