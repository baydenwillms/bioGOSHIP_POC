---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { themeConfig } from '~/theme.config';
import type { PaginateFunction } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allArticles = (await getCollection('articles', ({ id, data }) => {
    return !data.draft && id.startsWith(themeConfig.i18n.defaultLocale + '/');
  })) as CollectionEntry<'articles'>[];
  const uniqueTags = [...new Set(allArticles.flatMap(({ data }) => data.tags ?? []))];
  if (!uniqueTags.length) return [];
  return uniqueTags.flatMap((tag) => {
    const filtered = allArticles.filter((article) => article.data.tags?.includes(tag));
    return paginate(filtered, {
      params: { tag: tag.toLowerCase().replace(/\s/g, '-') },
      pageSize: themeConfig.articles?.entriesPerPage || 10,
    });
  });
}

const tag = Astro.params.tag;
const page = Astro.props.page?.currentPage;
const suffix = page && page > 1 ? `/${page}` : '';
return Astro.redirect(`/posts/tags/${tag}${suffix}`, 301);
---
