---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import "@styles/markdown.css";

export async function getStaticPaths() {
  const entries = (await getCollection("protocols", ({ data }) => !data.draft)) as CollectionEntry<"protocols">[];
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const entry = (await getEntry("protocols", Astro.params.slug as string)) as CollectionEntry<"protocols"> | undefined;
if (!entry) return Astro.rewrite("/404_dynamic");

const { Content } = await render(entry);

const rawFile = entry.data.file || entry.data.url;
const href = rawFile ? (/^https?:\/\//i.test(rawFile) ? rawFile : `${import.meta.env.BASE_URL.replace(/\/$/, "")}${rawFile.startsWith("/") ? rawFile : `/${rawFile}`}`) : undefined;
---

<Layout title={entry.data.title} description={entry.data.description} header={{ button: { text: t('labels.back-all-protocols'), href: getLocaleUrl('protocols', locale) } }} {locale}>
  <Headline text={entry.data.title} class="pb-4" />
  <p class="text-secondary-dark dark:text-secondary-light mb-6 text-xs font-semibold tracking-[0.16em] uppercase">{entry.data.category}</p>
  {
    href && (
      <p class="mb-8">
        <a href={href} class="text-primary dark:text-primary-light font-semibold" target="_blank" rel="noopener">
          {t('pages.protocols.download')}
        </a>
      </p>
    )
  }
  <div class="markdown-content max-w-3xl">
    <Content />
  </div>
</Layout>
