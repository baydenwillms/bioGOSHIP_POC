---
import { Icon } from "astro-icon/components";

interface Props {
  text: string;
  class?: string;
  icon?: string;
}

const { text, class: className = "", icon } = Astro.props;
---

<div class:list={["mb-5", className]}>
  <h1 class="font-headline text-primary flex items-center gap-2 text-3xl leading-[1.08] font-bold tracking-[-0.025em] sm:text-5xl dark:text-white">
    {icon && <Icon name={icon} class="text-secondary mt-0.5 h-7 w-7 shrink-0 sm:mt-1 sm:h-10 sm:w-10" />}
    {text}
  </h1>
  <div class="bg-accent mt-3 h-0.5 w-10" aria-hidden="true"></div>
</div>
