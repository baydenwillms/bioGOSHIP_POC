---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Reveal from "@components/reveal.astro";
import SiteMap, { type MapTrack } from "@components/map/site-map.astro";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { colorsForIds } from "@utils/helpers";
import { themeConfig } from "~/theme.config";
import icebergPhoto from "../../icons/iceberg_ship_photo.jpg";
import Bathymetry from "../../icons/bathymetric_map_no_numbers.svg";
import Copepod from "../../images/phyolpic/sm_copepod.svg";
import Pterocorys from "../../images/phyolpic/sm_pterocorys.svg";
import Strombidiidae from "../../images/phyolpic/sm_strombidiidae.svg";
import Dolphin from "../../images/phyolpic/xl_dolphin.svg";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;
const t = useTranslations(locale);

const features = [
  { slug: "feature-ai" },
  { slug: "feature-speed" },
  { slug: "feature-theme" },
  { slug: "feature-i18n" },
  { slug: "feature-content" },
  { slug: "feature-dx" },
] as const;

function newestBy<T>(items: T[], score: (item: T) => number): T | undefined {
  if (items.length === 0) return undefined;
  return [...items].sort((a, b) => score(b) - score(a))[0];
}

const articles = await getCollection("articles", ({ id, data }) => !data.draft && id.startsWith(`${locale}/`));
const latestPost = newestBy(articles, (entry) => entry.data.publishDate.getTime());

const cruises = await getCollection("cruises", ({ data }) => !data.draft);
const latestCruise = newestBy(cruises, (entry) => entry.data.date?.getTime() ?? 0);

const mappedCruises = [...cruises]
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .filter((entry) => {
    const points = entry.data.map?.points ?? [];
    const line = entry.data.map?.line ?? [];
    return points.length > 0 || line.length > 1;
  });
const trackColors = colorsForIds(mappedCruises.map((entry) => entry.id));
const cruiseTracks: MapTrack[] = mappedCruises.map((entry, i) => ({
  id: entry.id,
  title: entry.data.title,
  href: getLocaleUrl(`cruises/${entry.id}`, locale),
  color: trackColors.at(i) ?? "#282687",
  dashArray: i % 2 === 1 ? "9 7" : undefined,
  points: entry.data.map?.points ?? [],
  line: entry.data.map?.line ?? [],
}));
const cruisesUrl = getLocaleUrl("cruises", locale);

const protocols = await getCollection("protocols", ({ data }) => !data.draft);
const latestProtocol = newestBy(protocols, (entry) => (entry.data.updateDate ?? entry.data.publishDate)?.getTime() ?? 0);

const publications = await getCollection("publications", ({ data }) => !data.draft);
const latestPublication = [...publications].sort((a, b) => {
  const year = (b.data.year ?? 0) - (a.data.year ?? 0);
  if (year !== 0) return year;
  return a.data.title.localeCompare(b.data.title);
})[0];

interface LatestItem {
  typeKey: "latest-post" | "latest-cruise" | "latest-protocol" | "latest-publication";
  title: string;
  blurb: string;
  href: string;
}

const latestItems: LatestItem[] = [];

if (latestPost) {
  latestItems.push({
    typeKey: "latest-post",
    title: latestPost.data.title,
    blurb: latestPost.data.excerpt ?? "",
    href: getLocaleUrl(`posts/${latestPost.id.split("/")[1]}`, locale),
  });
}

if (latestCruise) {
  latestItems.push({
    typeKey: "latest-cruise",
    title: latestCruise.data.title,
    blurb: latestCruise.data.caption ?? "",
    href: getLocaleUrl(`cruises/${latestCruise.id}`, locale),
  });
}

if (latestProtocol) {
  latestItems.push({
    typeKey: "latest-protocol",
    title: latestProtocol.data.title,
    blurb: latestProtocol.data.description,
    href: getLocaleUrl(`protocols/${latestProtocol.id}`, locale),
  });
}

if (latestPublication) {
  const yearBit = latestPublication.data.year ? ` (${latestPublication.data.year})` : "";
  const sourceBit = latestPublication.data.source ? ` · ${latestPublication.data.source}` : "";
  latestItems.push({
    typeKey: "latest-publication",
    title: latestPublication.data.title,
    blurb: `${latestPublication.data.authors}${yearBit}${sourceBit}`,
    href: getLocaleUrl(`publications/${latestPublication.id}`, locale),
  });
}

const useCases = [{ slug: "usecase-portfolio" }, { slug: "usecase-company" }, { slug: "usecase-saas" }, { slug: "usecase-listing" }] as const;

const faqUrl = getLocaleUrl("faq", locale);
const contactUrl = getLocaleUrl("contact", locale);

function cruiseShortName(title: string) {
  const cut = title.indexOf(":");
  return cut > 0 ? title.slice(0, cut) : title;
}
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- Features on a faint bathymetry field -->
  <div class="bathy-section relative">
    <div class="bathy-section__art pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Bathymetry class="bathy-outline text-primary h-full w-full opacity-[0.09] dark:text-white dark:opacity-[0.07]" />
    </div>
    <div class="container relative z-10 mx-auto py-20">
      <section aria-labelledby="home-features-heading">
        <Reveal class="mb-10">
          <h2 id="home-features-heading" class="font-headline text-primary m-0 text-2xl font-bold tracking-[-0.025em] sm:text-3xl dark:text-white">
            {t('home-content.features-heading')}
          </h2>
          <div class="bg-accent mt-2 mb-4 h-0.5 w-10" aria-hidden="true"></div>
          <p class="m-0 max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.features-sub')}
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-x-10 md:gap-y-8">
          <div class="flex flex-col md:col-span-7 md:col-start-6 md:row-span-6 md:row-start-1">
            <div class="h-64 w-full sm:h-72 md:h-[24rem]">
              <SiteMap
                id="home-cruises-map"
                label={t("home-content.features-map-label")}
                tracks={cruiseTracks}
                fitMaxZoom={4}
                class="mt-0 h-full w-full rounded-xl"
              />
            </div>
            <div class="mt-4 shrink-0">
              <p class="text-primary m-0 text-sm font-semibold dark:text-white">{t("home-content.features-map-legend")}</p>
              {
                cruiseTracks.length === 0 ? (
                  <p class="mt-2 mb-0 text-sm text-stone-600 dark:text-stone-300">{t("home-content.features-map-empty")}</p>
                ) : (
                  <ul class="mt-3 mb-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0">
                    {cruiseTracks.map((track) => (
                      <li class="m-0">
                        <a href={track.href} class="inline-flex items-center gap-2 text-sm text-stone-700 no-underline hover:underline dark:text-stone-200">
                          <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full" style={`background-color: ${track.color}`} aria-hidden="true" />
                          {cruiseShortName(track.title)}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
              <p class="mt-3 mb-0">
                <a href={cruisesUrl} class="text-primary dark:text-primary-light text-sm font-semibold no-underline hover:underline">
                  {t("home-content.features-map-all")}
                  <span aria-hidden="true"> →</span>
                </a>
              </p>
            </div>
          </div>

          {
            features.map((feature) => (
              <article class="md:col-span-5">
                <h3 class="text-primary mt-0 mb-0 text-lg font-bold dark:text-white">{t(`home-content.${feature.slug}-title`)}</h3>
                <div class="bg-accent mt-2 mb-3 h-0.5 w-10" aria-hidden="true"></div>
                <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${feature.slug}-text`)}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <!-- Photo pans slower than the page: iceberg/sky first, then the ship deck. -->
  <div class="parallax-photo" data-parallax-photo>
    <div class="parallax-photo__window">
      <Image src={icebergPhoto} alt="" class="parallax-photo__media" data-parallax-photo-el widths={[800, 1280, 1920]} sizes="100vw" />
      <Dolphin class="phylo-deco phylo-deco--on-photo z-10 bottom-[6%] left-[3%] hidden h-24 w-auto md:block lg:h-28" />
      <div class="parallax-photo__overlay">
        <Reveal class="flex flex-col items-center gap-3 px-6 text-center">
          <span class="text-sm font-semibold tracking-[0.2em] text-white/80 uppercase">
            {t('home-content.parallax-eyebrow')}
          </span>
          <h2 class="text-3xl font-bold text-white drop-shadow-lg sm:text-4xl">
            {t('home-content.parallax-heading')}
          </h2>
        </Reveal>
      </div>
    </div>
  </div>

  <!-- Newest post, cruise, protocol, and publication. -->
  <div class="relative">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Strombidiidae class="phylo-deco top-[18%] left-[2%] hidden h-10 w-auto sm:block" />
    </div>
    <div class="container relative z-10 mx-auto py-20">
    <section aria-labelledby="home-voices-heading">
      <Reveal class="mb-10">
        <h2 id="home-voices-heading" class="font-headline text-primary m-0 text-2xl font-bold tracking-[-0.025em] sm:text-3xl dark:text-white">
          {t('home-content.voices-heading')}
        </h2>
        <div class="bg-accent mt-2 mb-4 h-0.5 w-10" aria-hidden="true"></div>
        <p class="m-0 max-w-2xl text-stone-600 dark:text-stone-300">
          {t('home-content.voices-sub')}
        </p>
      </Reveal>

      {
        latestItems.length === 0 ? (
          <p class="text-stone-600 dark:text-stone-300">{t('home-content.latest-empty')}</p>
        ) : (
          <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 md:grid-cols-2 md:gap-6">
            {latestItems.map((item) => (
              <li class="m-0">
                <article class="h-full rounded-xl border border-stone-300 bg-white p-5 dark:border-stone-600 dark:bg-stone-800">
                  <p class="text-primary dark:text-primary-light m-0 text-xs font-semibold tracking-[0.16em] uppercase">{t(`home-content.${item.typeKey}`)}</p>
                  <h3 class="text-primary mt-2 mb-0 text-lg font-bold dark:text-white">
                    <a href={item.href} class="text-inherit no-underline hover:underline">
                      {item.title}
                    </a>
                  </h3>
                  <div class="bg-accent mt-2 mb-3 h-0.5 w-10" aria-hidden="true"></div>
                  {item.blurb && <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{item.blurb}</p>}
                  <p class="mt-3 mb-0">
                    <a href={item.href} class="text-primary dark:text-primary-light text-sm font-semibold no-underline hover:underline">
                      {t('home-content.latest-open')}
                      <span aria-hidden="true"> →</span>
                    </a>
                  </p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    </div>
  </div>

  <div class="relative">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Pterocorys class="phylo-deco top-[22%] right-[4%] hidden h-11 w-auto sm:block" />
      <Copepod class="phylo-deco bottom-[16%] left-[3%] hidden h-10 w-auto md:block" />
    </div>
    <div class="container relative z-10 mx-auto py-20">
      <section aria-labelledby="home-usecases-heading">
        <Reveal class="mb-10">
          <h2 id="home-usecases-heading" class="font-headline text-primary m-0 text-2xl font-bold tracking-[-0.025em] sm:text-3xl dark:text-white">
            {t('home-content.usecases-heading')}
          </h2>
          <div class="bg-accent mt-2 mb-4 h-0.5 w-10" aria-hidden="true"></div>
          <p class="m-0 max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.usecases-sub')}
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
          {
            useCases.map((uc) => (
              <article class="h-full rounded-xl border border-stone-300 bg-white p-5 dark:border-stone-600 dark:bg-stone-800">
                <h3 class="text-primary mt-0 mb-0 text-lg font-bold dark:text-white">{t(`home-content.${uc.slug}-title`)}</h3>
                <div class="bg-accent mt-2 mb-3 h-0.5 w-10" aria-hidden="true"></div>
                <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${uc.slug}-text`)}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <div class="container mx-auto py-20">
    <div class="relative mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
      <h2 class="text-3xl font-bold text-stone-900 sm:text-4xl dark:text-white">{t('home-content.cta-heading')}</h2>
      <p class="max-w-xl text-stone-600 dark:text-stone-300">
        {t('home-content.cta-sub')}
      </p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
        <a href={faqUrl} class="btn-primary group">
          {t('home-content.cta-primary')}
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
        </a>
        <a href={contactUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
          <span>{t('home-content.cta-secondary')}</span>
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/tailwind.config.css";

  .bathy-section__art :global(svg) {
    width: 140%;
    max-width: none;
    height: 100%;
    margin-left: -20%;
  }

  /*
    The photo is taller than the window. Scroll moves the image slower than the
    page, so you start on the iceberg/sky and pan down onto the ship deck.
  */
  .parallax-photo {
    position: relative;
    height: 100vh;
    min-height: 28rem;
    overflow: hidden;
  }

  .parallax-photo__window {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .parallax-photo__media {
    position: absolute;
    left: 0;
    top: -20%;
    width: 100%;
    height: 160%;
    object-fit: cover;
    object-position: center 45%;
    pointer-events: none;
    transform: translate3d(0, var(--photo-shift, 0%), 0);
    will-change: transform;
  }

  .parallax-photo__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    width: 100%;
    align-items: center;
    justify-content: center;
  }

  .parallax-photo__window::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(20, 19, 70, 0.28), rgba(20, 19, 70, 0.5));
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .parallax-photo {
      height: 70vh;
      min-height: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-photo__media {
      top: 0;
      height: 100%;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Map how far the photo band has travelled through the viewport to a
   * vertical shift. 0 = just entering from below, 1 = just leaving above.
   */
  let cleanupParallaxPhoto = () => {};

  function setupParallaxPhoto() {
    cleanupParallaxPhoto();

    const root = document.querySelector<HTMLElement>('[data-parallax-photo]');
    const media = root?.querySelector<HTMLElement>('[data-parallax-photo-el]');
    if (!root || !media) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;

    const updateShift = () => {
      const rect = root.getBoundingClientRect();
      const viewH = window.innerHeight;
      const progress = (viewH - rect.top) / (viewH + rect.height);
      const clamped = Math.min(Math.max(progress, 0), 1);
      const travel = window.matchMedia('(min-width: 769px)').matches ? 22 : 12;
      const shift = (0.5 - clamped) * travel;
      media.style.setProperty('--photo-shift', `${shift}%`);
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateShift);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateShift();

    cleanupParallaxPhoto = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      cleanupParallaxPhoto = () => {};
    };
  }

  setupParallaxPhoto();
  document.addEventListener('astro:page-load', setupParallaxPhoto);
  document.addEventListener('astro:before-swap', () => cleanupParallaxPhoto());
</script>
