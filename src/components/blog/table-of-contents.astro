---
import { useTranslations } from "@utils/i18n";

interface Props {
  headings: Array<{
    depth: number;
    text: string;
    slug: string;
  }>;
  locale: string;
  baseUrl?: string;
  overlay?: boolean;
}

const { headings, locale, baseUrl, overlay } = Astro.props as Props;
const t = useTranslations(locale);
---

<h2 class:list={["m-0 font-semibold", overlay ? "text-2xl" : "text-sm tracking-[0.14em] uppercase"]}>{t("labels.toc")}</h2>
<nav class:list={[overlay ? "mt-6" : "mt-3"]} aria-label={t("labels.toc")}>
  <a href="#start" class:list={["block font-normal no-underline hover:underline", overlay ? "text-base" : "text-sm text-stone-600 dark:text-stone-300"]}>
    {t("labels.to-start")}
  </a>
  {
    headings.map(({ depth, text, slug }: { depth: number; text: string; slug: string }) => (
      <a
        title={text}
        class:list={[
          "toc-link mt-2 block font-normal no-underline hover:underline",
          overlay ? "text-base" : "text-sm text-stone-600 dark:text-stone-300",
          depth === 3 && "pl-3",
          ![1, 2, 3].includes(depth) && "pl-5",
        ]}
        href={(baseUrl ? baseUrl : "") + "#" + slug}
      >
        {text}
      </a>
    ))
  }
</nav>
