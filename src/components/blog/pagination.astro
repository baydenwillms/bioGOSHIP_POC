---
import { getLocaleUrl, useTranslations } from "@utils/i18n";
import type { Page } from "astro";

interface Props {
  page: Page;
  baseUrl?: string;
  locale: string;
  class?: string;
}

const { page, baseUrl = "posts", locale } = Astro.props as Props;
const classOverride = Astro.props.class || "mt-12";
const t = useTranslations(locale);

function generatePaginationItems(page: Page) {
  const numberofPages = Math.ceil(page.total / page.size);
  if (numberofPages <= 5) {
    return Array.from({ length: numberofPages }, (_, i) => i + 1);
  }
  const pagesToShow = new Set<number>();
  pagesToShow.add(1);
  pagesToShow.add(numberofPages);
  if (page.currentPage <= 3) {
    pagesToShow.add(2);
    pagesToShow.add(3);
    pagesToShow.add(4);
  } else if (page.currentPage >= numberofPages - 2) {
    pagesToShow.add(numberofPages - 3);
    pagesToShow.add(numberofPages - 2);
    pagesToShow.add(numberofPages - 1);
  } else {
    pagesToShow.add(page.currentPage - 1);
    pagesToShow.add(page.currentPage);
    pagesToShow.add(page.currentPage + 1);
  }
  return Array.from(pagesToShow).sort((a, b) => a - b);
}

const paginationItems = generatePaginationItems(page);
const numberofPages = Math.ceil(page.total / page.size);
---

<nav aria-label={t("labels.pagination")} class={classOverride}>
  <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-5 gap-y-2 p-0 text-sm">
    <li class="m-0">
      {
        page.url.prev ? (
          <a href={page.url.prev} class="font-semibold no-underline hover:underline">
            {t("labels.prev")}
          </a>
        ) : (
          <span class="text-stone-400">{t("labels.prev")}</span>
        )
      }
    </li>
    {
      paginationItems.map((pageNum, index, array) => (
        <>
          <li class="m-0 hidden md:block">
            <a
              href={pageNum === 1 ? getLocaleUrl("/" + baseUrl, locale) : getLocaleUrl(`/${baseUrl}/${pageNum}`, locale)}
              aria-current={pageNum === page.currentPage ? "page" : undefined}
              aria-label={`${t("labels.page")} ${pageNum}`}
              class:list={[pageNum === page.currentPage ? "text-primary dark:text-primary-light font-bold no-underline" : "font-semibold no-underline hover:underline"]}
            >
              {pageNum}
            </a>
          </li>
          {array[index + 1] && array[index + 1] - pageNum > 1 && (
            <li class="m-0 hidden text-stone-400 md:block" aria-hidden="true">
              …
            </li>
          )}
        </>
      ))
    }
    <li class="m-0 md:hidden">
      <span>
        {t("labels.page")} {page.currentPage} / {numberofPages}
      </span>
    </li>
    <li class="m-0">
      {
        page.url.next ? (
          <a href={page.url.next} class="font-semibold no-underline hover:underline">
            {t("labels.next")}
          </a>
        ) : (
          <span class="text-stone-400">{t("labels.next")}</span>
        )
      }
    </li>
  </ul>
</nav>
