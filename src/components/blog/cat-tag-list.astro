---
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  entries?: (string | undefined)[];
  locale: string;
  type: "tags" | "categories";
  small?: boolean;
}

const { entries, locale, type, small } = Astro.props as Props;
const t = useTranslations(locale);

const items = (entries ?? []).filter((entry): entry is string => Boolean(entry));

function slugify(value: string) {
  return value.toLowerCase().replace(/\s/g, "-");
}

function label(value: string) {
  return t(`${type}-t.${value}`);
}

/** Fixed colors per category so News is always News, not a random hash. */
const categoryPill: Record<string, string> = {
  news: "bg-primary text-white",
  "cruise-updates": "bg-secondary text-secondary-contrast",
  papers: "bg-primary-dark text-white",
  methods: "bg-accent text-accent-contrast",
  training: "bg-secondary-dark text-white",
  general: "bg-stone-600 text-white",
  sampling: "bg-primary-light text-white",
  community: "bg-secondary-dark text-white",
  data: "bg-accent-dark text-white",
};
---

{
  items.length > 0 ? (
    <ul class:list={["m-0 flex list-none flex-wrap p-0", small ? "gap-1.5" : "gap-2"]}>
      {items.map((entry) => (
        <li class="m-0 mt-0">
          <a
            href={getLocaleUrl(`posts/${type}/${slugify(entry)}`, locale)}
            class:list={[
              "inline-flex items-center rounded-full font-semibold no-underline hover:opacity-80",
              small ? "px-2.5 py-0.5 text-xs" : "px-3 py-1 text-sm",
              type === "categories"
                ? (categoryPill[slugify(entry)] ?? "bg-primary text-white")
                : "bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-200",
            ]}
          >
            {label(entry)}
          </a>
        </li>
      ))}
    </ul>
  ) : small ? null : (
    <p class="text-stone-600 dark:text-stone-300">{t("labels.no-entries")}</p>
  )
}
