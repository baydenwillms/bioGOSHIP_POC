---
import { getLocaleUrl, useTranslations } from "@utils/i18n";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CatTagList from "@components/blog/cat-tag-list.astro";

interface Props {
  entry: CollectionEntry<"articles">;
  locale: string;
  noTransition?: boolean;
}

const { entry, locale, noTransition } = Astro.props as Props;
const t = useTranslations(locale);

const href = getLocaleUrl("posts/" + entry.id.split("/").slice(-1)[0], locale);
const categories = entry.data.categories ?? [];
const tags = entry.data.tags ?? [];
const imageFile = entry.data.image?.file;
const imageUrl = !imageFile && entry.data.image?.url ? entry.data.image.url : undefined;
const dateLabel = entry.data.publishDate.toLocaleDateString(locale, { dateStyle: "medium" });

function previewText(body?: string, excerpt?: string) {
  const source = (body && body.trim()) || excerpt?.trim() || "";
  if (!source) return "";
  return source
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/!\[[^\]]*\]\([^)]+\)/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_`~]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

const preview = previewText(entry.body, entry.data.excerpt);
---

<article>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    {entry.data.featured && <span class="text-secondary-dark dark:text-secondary-light text-xs font-semibold tracking-[0.14em] uppercase">{t("labels.featured")}</span>}
    {categories.length > 0 && <CatTagList entries={categories} {locale} type="categories" small />}
    <time class="text-xs text-stone-500" datetime={entry.data.publishDate.toISOString()}>
      {dateLabel}
    </time>
  </div>

  <a href={href} class="group mt-3 block text-inherit no-underline">
    <h2 class="font-headline text-primary m-0 text-xl font-bold tracking-[-0.025em] group-hover:underline dark:text-white">{entry.data.title}</h2>
    {preview && <p class="mt-2 mb-0 line-clamp-6 text-[0.95rem] leading-relaxed text-stone-600 dark:text-stone-300">{preview}</p>}
    {
      imageFile ? (
        <Image
          src={imageFile}
          alt={entry.data.image?.alt ?? ""}
          class="mt-4 max-h-[28rem] w-full rounded-xl object-cover"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 48rem, 100vw"
          transition:name={!noTransition ? "image-" + entry.id : ""}
          draggable="false"
        />
      ) : imageUrl ? (
        <Image
          src={imageUrl}
          alt={entry.data.image?.alt ?? ""}
          class="mt-4 max-h-[28rem] w-full rounded-xl object-cover"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 48rem, 100vw"
          transition:name={!noTransition ? "image-" + entry.id : ""}
          draggable="false"
          inferSize
        />
      ) : null
    }
  </a>

  {tags.length > 0 && <div class="mt-3"><CatTagList entries={tags} {locale} type="tags" small /></div>}
</article>
