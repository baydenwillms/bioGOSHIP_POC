---
import ListItem from "@components/blog/list-item.astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@utils/i18n";

interface Props {
  entries: CollectionEntry<"articles">[];
  locale: string;
}

const { entries, locale } = Astro.props as Props;
const t = useTranslations(locale);
---

{
  entries.length > 0 ? (
    <ul class="m-0 flex max-w-3xl list-none flex-col gap-10 p-0 sm:gap-12" aria-label={t("pages.blog.title")}>
      {entries.map((entry) => (
        <li class="m-0 mt-0">
          <ListItem {entry} {locale} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-stone-600 dark:text-stone-300">{t("labels.no-entries")}</p>
  )
}
