---
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  locale: string;
  isHome?: boolean;
}

const { locale, isHome } = Astro.props as Props;
const t = useTranslations(locale);
---

<nav role="navigation" class="text-text-dark xs:items-start flex w-full flex-col items-center text-left text-sm md:w-auto">
  <h3>{t('labels.company')}</h3>
  {
    !isHome ? (
      <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('/', locale)}>
        {t('nav.home')}
      </a>
    ) : (
      ''
    )
  }
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('team/international', locale)}>{t('nav.team')}</a>
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('posts', locale)}>{t('nav.blog')}</a>
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('publications', locale)}>{t('nav.publications')}</a>
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('cruises', locale)}>{t('nav.cruises')}</a>
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('protocols', locale)}>{t('nav.protocols')}</a>
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('faq', locale)}>{t('nav.faq')}</a>
  <a class="unstyle-link hover:text-text-dark text-text-dark/80 w-fit pt-1.5" href={getLocaleUrl('contact', locale)}>{t('nav.contact')}</a>
</nav>
