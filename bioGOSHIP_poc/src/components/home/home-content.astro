---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Reveal from "@components/reveal.astro";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import icebergPhoto from "../../icons/iceberg_ship_photo.jpg";
import Bathymetry from "../../icons/bathymetric_map_no_numbers.svg";
import Copepod from "../../images/phyolpic/sm_copepod.svg";
import Pterocorys from "../../images/phyolpic/sm_pterocorys.svg";
import Strombidiidae from "../../images/phyolpic/sm_strombidiidae.svg";
import Shrimp from "../../images/phyolpic/md_shrimp.svg";
import Dolphin from "../../images/phyolpic/xl_dolphin.svg";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;
const t = useTranslations(locale);

interface FeatureCard {
  slug: string;
  icon: string;
  accent: "primary" | "secondary" | "accent";
}

const features: FeatureCard[] = [
  { slug: "feature-ai", icon: "heroicons:beaker", accent: "primary" },
  { slug: "feature-speed", icon: "heroicons:camera", accent: "secondary" },
  { slug: "feature-theme", icon: "heroicons:cube", accent: "accent" },
  { slug: "feature-i18n", icon: "heroicons:sun", accent: "secondary" },
  { slug: "feature-content", icon: "heroicons:globe-alt", accent: "primary" },
  { slug: "feature-dx", icon: "heroicons:academic-cap", accent: "accent" },
];

interface NewsPost {
  slug: string;
  image?: ImageMetadata;
  phylopic?: "copepod" | "pterocorys" | "shrimp";
}

const posts: NewsPost[] = [
  { slug: "voice-1", phylopic: "copepod" },
  { slug: "voice-2", phylopic: "pterocorys" },
  { slug: "voice-3", image: icebergPhoto },
  { slug: "voice-4", phylopic: "shrimp" },
];

interface UseCase {
  slug: string;
  icon: string;
}

const useCases: UseCase[] = [
  { slug: "usecase-portfolio", icon: "heroicons:circle-stack" },
  { slug: "usecase-company", icon: "heroicons:check-badge" },
  { slug: "usecase-saas", icon: "heroicons:link" },
  { slug: "usecase-listing", icon: "heroicons:user-group" },
];

const accentBar: Record<FeatureCard["accent"], string> = {
  primary: "bg-primary",
  secondary: "bg-secondary",
  accent: "bg-accent",
};

const accentIcon: Record<FeatureCard["accent"], string> = {
  primary: "bg-primary/10 text-primary dark:bg-primary-darker dark:text-primary-light",
  secondary: "bg-secondary/10 text-secondary-dark dark:bg-secondary-dark dark:text-secondary-light",
  accent: "bg-accent/15 text-accent-dark dark:bg-accent-dark dark:text-accent-light",
};

const faqUrl = getLocaleUrl("faq", locale);
const contactUrl = getLocaleUrl("contact", locale);
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- Features on a faint bathymetry field -->
  <div class="bathy-section relative">
    <div class="bathy-section__art pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Bathymetry class="bathy-outline text-primary h-full w-full opacity-[0.09] dark:text-white dark:opacity-[0.07]" />
    </div>
    <div class="container relative z-10 mx-auto py-20">
      <section aria-labelledby="home-features-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
            {t('home-content.features-eyebrow')}
          </span>
          <h2 id="home-features-heading" class="text-3xl font-bold text-stone-900 sm:text-4xl dark:text-white">
            {t('home-content.features-heading')}
          </h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.features-sub')}
          </p>
        </Reveal>

        <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((feature, i) => (
              <Reveal as="li" delay={i * 70} from="up" class="m-0">
                <article class="feature-card group relative h-full overflow-hidden rounded-xl border border-stone-200 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-lg dark:border-stone-700 dark:bg-stone-900">
                  <div class={`absolute inset-x-0 top-0 h-1 ${accentBar[feature.accent]}`} />
                  <span class={`mb-4 flex h-11 w-11 items-center justify-center rounded-lg ${accentIcon[feature.accent]}`}>
                    <Icon name={feature.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <h3 class="mb-2 text-lg font-bold">{t(`home-content.${feature.slug}-title`)}</h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${feature.slug}-text`)}</p>
                </article>
              </Reveal>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <!-- Photo pans slower than the page: iceberg/sky first, then the ship deck. -->
  <div class="parallax-photo" data-parallax-photo>
    <div class="parallax-photo__window">
      <Image src={icebergPhoto} alt="" class="parallax-photo__media" data-parallax-photo-el widths={[800, 1280, 1920]} sizes="100vw" />
      <Dolphin class="phylo-deco phylo-deco--on-photo z-10 bottom-[6%] left-[3%] hidden h-24 w-auto md:block lg:h-28" />
      <div class="parallax-photo__overlay">
        <Reveal class="flex flex-col items-center gap-3 px-6 text-center">
          <span class="text-sm font-semibold tracking-[0.2em] text-white/80 uppercase">
            {t('home-content.parallax-eyebrow')}
          </span>
          <h2 class="text-3xl font-bold text-white drop-shadow-lg sm:text-4xl">
            {t('home-content.parallax-heading')}
          </h2>
        </Reveal>
      </div>
    </div>
  </div>

  <!-- News as posts: image + title + description. Swap these for real posts later. -->
  <div class="relative">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Strombidiidae class="phylo-deco top-[18%] left-[2%] hidden h-10 w-auto sm:block" />
    </div>
    <div class="container relative z-10 mx-auto py-20">
    <section aria-labelledby="home-voices-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
          {t('home-content.voices-eyebrow')}
        </span>
        <h2 id="home-voices-heading" class="text-3xl font-bold text-stone-900 sm:text-4xl dark:text-white">
          {t('home-content.voices-heading')}
        </h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          {t('home-content.voices-sub')}
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          posts.map((post, i) => (
            <Reveal delay={i * 70} from="up">
              <article class="news-card flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-900">
                <div class="news-card__media relative aspect-16/10 overflow-hidden bg-primary/6 dark:bg-white/5">
                  {post.image ? (
                    <Image src={post.image} alt="" class="h-full w-full object-cover" widths={[400, 720]} sizes="(min-width: 640px) 50vw, 100vw" />
                  ) : (
                    <span class="text-primary absolute inset-0 flex items-center justify-center opacity-20 dark:text-white dark:opacity-30" aria-hidden="true">
                      {post.phylopic === 'pterocorys' && <Pterocorys class="phylo-outline h-28 w-auto" />}
                      {post.phylopic === 'shrimp' && <Shrimp class="phylo-outline h-24 w-auto" />}
                      {post.phylopic === 'copepod' && <Copepod class="phylo-outline h-24 w-auto" />}
                    </span>
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-2 p-6">
                  <span class="text-secondary-dark dark:text-secondary-light text-xs font-semibold tracking-[0.16em] uppercase">{t(`home-content.${post.slug}-role`)}</span>
                  <h3 class="text-lg font-bold">{t(`home-content.${post.slug}-name`)}</h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${post.slug}-quote`)}</p>
                </div>
              </article>
            </Reveal>
          ))
        }
      </div>
    </section>
    </div>
  </div>

  <div class="relative">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Pterocorys class="phylo-deco top-[22%] right-[4%] hidden h-11 w-auto sm:block" />
      <Copepod class="phylo-deco bottom-[16%] left-[3%] hidden h-10 w-auto md:block" />
    </div>
    <div class="container relative z-10 mx-auto py-20">
      <section aria-labelledby="home-usecases-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
            {t('home-content.usecases-eyebrow')}
          </span>
          <h2 id="home-usecases-heading" class="text-3xl font-bold text-stone-900 sm:text-4xl dark:text-white">
            {t('home-content.usecases-heading')}
          </h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.usecases-sub')}
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            useCases.map((uc, i) => (
              <Reveal delay={i * 70} from={i % 2 === 0 ? 'left' : 'right'}>
                <article class="usecase-card group hover:border-primary dark:hover:border-primary-light flex h-full items-start gap-5 rounded-xl border border-stone-200 bg-white p-6 transition-all hover:shadow-lg dark:border-stone-700 dark:bg-stone-900">
                  <span class="bg-primary/10 text-primary dark:bg-primary-darker dark:text-primary-light flex h-12 w-12 shrink-0 items-center justify-center rounded-lg">
                    <Icon name={uc.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <div class="flex flex-col gap-2">
                    <h3 class="text-lg font-bold">{t(`home-content.${uc.slug}-title`)}</h3>
                    <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${uc.slug}-text`)}</p>
                  </div>
                </article>
              </Reveal>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <div class="container mx-auto py-20">
    <div class="relative mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
      <h2 class="text-3xl font-bold text-stone-900 sm:text-4xl dark:text-white">{t('home-content.cta-heading')}</h2>
      <p class="max-w-xl text-stone-600 dark:text-stone-300">
        {t('home-content.cta-sub')}
      </p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
        <a href={faqUrl} class="btn-primary group">
          {t('home-content.cta-primary')}
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
        </a>
        <a href={contactUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
          <span>{t('home-content.cta-secondary')}</span>
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/tailwind.config.css";

  .bathy-section__art :global(svg) {
    width: 140%;
    max-width: none;
    height: 100%;
    margin-left: -20%;
  }

  /*
    The photo is taller than the window. Scroll moves the image slower than the
    page, so you start on the iceberg/sky and pan down onto the ship deck.
  */
  .parallax-photo {
    position: relative;
    height: 100vh;
    min-height: 28rem;
    overflow: hidden;
  }

  .parallax-photo__window {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .parallax-photo__media {
    position: absolute;
    left: 0;
    top: -20%;
    width: 100%;
    height: 160%;
    object-fit: cover;
    object-position: center 45%;
    pointer-events: none;
    transform: translate3d(0, var(--photo-shift, 0%), 0);
    will-change: transform;
  }

  .parallax-photo__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    width: 100%;
    align-items: center;
    justify-content: center;
  }

  .parallax-photo__window::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(20, 19, 70, 0.28), rgba(20, 19, 70, 0.5));
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .parallax-photo {
      height: 70vh;
      min-height: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-photo__media {
      top: 0;
      height: 100%;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Map how far the photo band has travelled through the viewport to a
   * vertical shift. 0 = just entering from below, 1 = just leaving above.
   */
  let cleanupParallaxPhoto = () => {};

  function setupParallaxPhoto() {
    cleanupParallaxPhoto();

    const root = document.querySelector<HTMLElement>('[data-parallax-photo]');
    const media = root?.querySelector<HTMLElement>('[data-parallax-photo-el]');
    if (!root || !media) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;

    const updateShift = () => {
      const rect = root.getBoundingClientRect();
      const viewH = window.innerHeight;
      const progress = (viewH - rect.top) / (viewH + rect.height);
      const clamped = Math.min(Math.max(progress, 0), 1);
      const travel = window.matchMedia('(min-width: 769px)').matches ? 22 : 12;
      const shift = (0.5 - clamped) * travel;
      media.style.setProperty('--photo-shift', `${shift}%`);
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateShift);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateShift();

    cleanupParallaxPhoto = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      cleanupParallaxPhoto = () => {};
    };
  }

  setupParallaxPhoto();
  document.addEventListener('astro:page-load', setupParallaxPhoto);
  document.addEventListener('astro:before-swap', () => cleanupParallaxPhoto());
</script>
