---
import type { CollectionEntry } from "astro:content";
import { getLocaleUrl } from "@utils/i18n";

interface Props {
  entries: CollectionEntry<"publications">[];
  locale: string;
}

const { entries, locale } = Astro.props;

function doiHref(doi?: string, url?: string) {
  if (url) return url;
  if (!doi) return undefined;
  return doi.startsWith("http") ? doi : `https://doi.org/${doi.replace(/^doi:/i, "")}`;
}

function citation(entry: CollectionEntry<"publications">) {
  const { authors, year, title, source } = entry.data;
  const yearBit = year ? ` (${year})` : "";
  const sourceBit = source ? ` ${source}.` : "";
  return `${authors}${yearBit}. ${title}.${sourceBit}`;
}
---

<ol class="m-0 flex list-none flex-col gap-5 p-0">
  {
    entries.map((entry) => {
      const href = doiHref(entry.data.doi, entry.data.url);
      const detail = getLocaleUrl(`publications/${entry.id}`, locale);
      return (
        <li class="m-0 rounded-xl border border-stone-200 bg-white p-5 dark:border-stone-700 dark:bg-stone-900">
          <p class="m-0 text-sm leading-relaxed text-stone-800 dark:text-stone-200">{citation(entry)}</p>
          <div class="mt-3 flex flex-wrap gap-4 text-sm">
            <a href={detail} class="text-primary dark:text-primary-light font-semibold no-underline hover:underline">
              Abstract
            </a>
            {href && (
              <a href={href} class="text-primary dark:text-primary-light font-semibold no-underline hover:underline" target="_blank" rel="noopener">
                {entry.data.doi ? "DOI" : "Link"}
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
