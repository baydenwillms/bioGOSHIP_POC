---
import { Icon } from "astro-icon/components";
import HeroChip from "@components/promo/hero-chip.astro";
import { themeConfig } from '~/theme.config';
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import Logo from "../../icons/bio_GOSHIP_logo_COLOR.svg";
import LogoMark from "../../icons/bio_GOSHIP_logo_SVG_unofficial.svg";
import Copepod from "../../images/phyolpic/sm_copepod.svg";
import Pterocorys from "../../images/phyolpic/sm_pterocorys.svg";
import Salmonella from "../../images/phyolpic/sm_salmonella.svg";
import Shrimp from "../../images/phyolpic/md_shrimp.svg";
import Tuna from "../../images/phyolpic/lg_bluefin_tuna.svg";
import Shark from "../../images/phyolpic/xl_lamniformes.svg";

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<div role="banner" class="hero relative flex min-h-svh w-full flex-col items-center justify-center overflow-hidden px-6 pt-32 pb-24">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Sized by rough real-world scale: bacterium < plankton < shrimp < tuna < shark -->
    <Salmonella class="phylo-deco top-[14%] left-[28%] hidden h-6 w-auto sm:block" />
    <Pterocorys class="phylo-deco top-[20%] right-[24%] h-10 w-auto sm:h-12" />
    <Copepod class="phylo-deco top-[42%] left-[18%] h-11 w-auto sm:h-12" />
    <Tuna class="phylo-deco top-[36%] right-[16%] hidden h-20 w-auto lg:block lg:h-24" />
    <Shrimp class="phylo-deco top-[68%] left-[22%] hidden h-14 w-auto sm:block md:h-16" />
    <Shark class="phylo-deco right-[10%] bottom-[8%] hidden h-36 w-auto md:block lg:h-44" />
  </div>

  <div class="relative z-10 flex w-full max-w-4xl flex-col items-center gap-6 text-center">
    {themeConfig.promotions?.heroChip && <HeroChip {locale} />}

    <Logo class="logo-color h-48 w-auto dark:hidden sm:h-60 md:h-72" role="img" aria-label={t('pages.home.hero-logo-alt')} />
    <LogoMark class="hidden h-48 w-auto text-white dark:block sm:h-60 md:h-72" role="img" aria-label={t('pages.home.hero-logo-alt')} />

    <h1 class="hero-title">{t('pages.home.hero-title')}</h1>
    <p class="hero-subline">{t('pages.home.hero-sub-slogan')}</p>

    <div class="flex flex-col gap-10">
      <div class="mt-1 flex flex-wrap justify-center gap-4">
        <a href={getLocaleUrl('about', locale)} class="btn-primary">{t('pages.home.hero-cta-primary')}</a>
        <a href={getLocaleUrl('contact', locale)} class="btn-subtle group rounded px-4 py-[0.43rem]">
          <span>{t('pages.home.hero-cta-secondary')}</span>
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" />
        </a>
      </div>
    </div>

    <div class="relative mt-10 max-w-2xl">
      <p class="mission-eyebrow">{t('pages.home.mission-eyebrow')}</p>
      <p class="mt-3 text-lg leading-relaxed text-stone-600 sm:text-xl dark:text-stone-300">{t('pages.home.mission-text')}</p>
    </div>
  </div>
</div>

<style>
  @reference "../../styles/tailwind.config.css";

  .hero {
    background-color: #ffffff;
  }

  :global(.dark) .hero {
    background-color: var(--color-background-dark);
  }

  .hero-title {
    @apply text-primary m-0 leading-[1.08] font-bold tracking-[-0.025em];
    font-size: clamp(2.4rem, 6vw, 4.8rem);
  }

  :global(.dark) .hero-title {
    @apply text-white;
  }

  .hero-subline {
    @apply m-0 max-w-[38rem] leading-[1.65] text-stone-600;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
  }

  :global(.dark) .hero-subline {
    @apply text-stone-300;
  }

  .mission-eyebrow {
    @apply text-primary text-sm font-semibold tracking-[0.2em] uppercase;
  }

  :global(.dark) .mission-eyebrow {
    @apply text-primary-light;
  }

  .mission-eyebrow::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 2px;
    margin: 0.65rem auto 0;
    background: var(--color-accent);
  }
</style>
