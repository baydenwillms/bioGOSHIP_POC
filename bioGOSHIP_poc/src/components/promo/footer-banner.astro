---
import { Icon } from "astro-icon/components";
import LogoMark from "../../icons/bio_GOSHIP_logo_SVG_unofficial.svg";
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<div id="footer-banner" class="bg-primary relative w-full overflow-hidden px-6 py-20 xs:px-10 sm:px-20">
  <div class="relative z-10 flex items-center justify-center gap-20 text-center xl:gap-32">
    <div class="-mt-10 hidden lg:block">
      <LogoMark class="h-40 w-auto text-white" />
    </div>
    <div class="flex flex-col items-center justify-center gap-4 px-5 py-8 xs:px-10 lg:px-16 lg:py-14">
      <h2 class="text-4xl font-bold text-white">{t('global-promo.footer-heading')}</h2>
      <p class="max-w-xl text-lg text-white/80">{t('global-promo.footer-text')}</p>
      <a href={getLocaleUrl('about', locale)} role="button" class="btn-primary group mt-6 bg-white text-primary hover:bg-secondary hover:text-white">
        {t('global-promo.footer-cta')}
        <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>
