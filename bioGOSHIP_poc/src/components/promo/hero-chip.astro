---
import { Icon } from "astro-icon/components";
import { useTranslations } from "@utils/i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<a href="#home-features-heading" class="group xs:text-[0.8rem] border-primary/25 bg-primary/8 text-primary hover:border-primary flex items-center gap-1.5 rounded-full border px-4 py-1.5 text-[0.7rem] font-semibold no-underline dark:border-white/25 dark:bg-white/10 dark:text-white dark:hover:border-white">
  <span class="bg-accent h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
  <span>{t('pages.home.hero-chip')}</span>
  <Icon name="heroicons:arrow-right" class="h-3 w-3 transition-all duration-300 group-hover:ml-1" />
</a>
