---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import "@styles/markdown.css";

export async function getStaticPaths() {
  const entries = (await getCollection("publications", ({ data }) => !data.draft)) as CollectionEntry<"publications">[];
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const entry = (await getEntry("publications", Astro.params.slug as string)) as CollectionEntry<"publications"> | undefined;
if (!entry) return Astro.rewrite("/404_dynamic");

const { Content } = await render(entry);
const doi = entry.data.doi;
const href = entry.data.url || (doi ? (doi.startsWith("http") ? doi : `https://doi.org/${doi.replace(/^doi:/i, "")}`) : undefined);
---

<Layout title={entry.data.title} description={entry.data.authors} header={{ button: { text: t("labels.back-all-publications"), href: getLocaleUrl("publications", locale) } }} {locale}>
  <Headline text={entry.data.title} class="pb-4" />
  <p class="mb-2 text-stone-600 dark:text-stone-300">{entry.data.authors}{entry.data.year ? ` (${entry.data.year})` : ""}</p>
  {entry.data.source && <p class="mb-6 text-sm italic text-stone-500">{entry.data.source}</p>}
  {href && (
    <p class="mb-8">
      <a href={href} class="text-primary dark:text-primary-light font-semibold" target="_blank" rel="noopener">
        {doi ? `doi:${doi}` : href}
      </a>
    </p>
  )}
  <div class="markdown-content max-w-3xl">
    <Content />
  </div>
</Layout>
